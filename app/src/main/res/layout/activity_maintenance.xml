<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F7F5">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maintenance Tracking"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#173F35"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap any report to update its maintenance status."
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvEmptyMaintenance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No reports available yet."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listMaintenance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnMaintenanceBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard" />

</LinearLayout>
