<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GroundWatch Admin"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Review problems, assign severity and track maintenance."
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReviewProblems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Review Problems / Assign Severity" />

        <Button
            android:id="@+id/btnAdminReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="My Reports" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View all reports submitted by users."
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAdminProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Profile / Logout" />

    </LinearLayout>

</ScrollView>